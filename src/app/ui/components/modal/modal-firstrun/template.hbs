<div>
	{{#modal-header tagName="h2"}}
		{{t "modal.firstrun.header"}}
	{{/modal-header}}
	{{#modal-body}}
		<p>{{t "modal.firstrun.body"}}</p>
		<div class="state-actions">
			<button type="button" class="state-action" {{action "settings" "settings.streaming"}}>
				{{t "modal.firstrun.action.streamlink"}}
			</button>
			<button type="button" class="state-action" {{action "settings" "settings.player"}}>
				{{t "modal.firstrun.action.player"}}
			</button>
		</div>
	{{/modal-body}}
	{{#modal-footer classNames="state-actions"}}
		<button type="button" class="state-action state-action-primary firstrun-continue" {{action "close"}}>
			{{t "modal.firstrun.action.start"}}
		</button>
	{{/modal-footer}}
</div>
