<div>
	{{#modal-header}}
		{{#if error}}
			{{#if isLogError}}
				{{t "modal.streaming.header.error.log"}}
			{{else if isProviderError}}
				{{t "modal.streaming.header.error.provider" provider=providerName}}
			{{else if isPlayerError}}
				{{t "modal.streaming.header.error.player"}}
			{{else if isVersionError}}
				{{t "modal.streaming.header.error.version" provider=providerName}}
			{{else if isUnableToOpenError}}
				{{t "modal.streaming.header.error.unable-to-open"}}
			{{else if isNoStreamsFoundError}}
				{{t "modal.streaming.header.error.no-streams-found"}}
			{{else if isTimeoutError}}
				{{t "modal.streaming.header.error.timeout"}}
			{{else}}
				{{t "modal.streaming.header.error.internal"}}
			{{/if}}
		{{else if preparing}}
			{{t "modal.streaming.header.preparing"}}
		{{else}}
			{{#link-to "channel" modalContext.user.id tabindex=0}}
				{{#if modalContext.hasEnded}}
					{{t "modal.streaming.header.ended" channel=modalContext.user.detailedName}}
				{{else if modalContext.isLaunching}}
					{{t "modal.streaming.header.launching" channel=modalContext.user.detailedName}}
				{{else}}
					{{t "modal.streaming.header.watching" channel=modalContext.user.detailedName}}
				{{/if}}
			{{/link-to}}
		{{/if}}
	{{/modal-header}}
	{{#modal-body}}
		{{#if error}}
			<p class="streaming-message" role="alert">
				{{#if isProviderError}}
					{{t "modal.streaming.body.error.provider" provider=providerName}}
				{{else if isPlayerError}}
					{{t "modal.streaming.body.error.player"}}
				{{else if isVersionError}}
					{{t "modal.streaming.body.error.version" version=error.message required=versionMin}}
				{{else if isUnableToOpenError}}
					{{t "modal.streaming.body.error.unable-to-open" provider=providerName}}
				{{else if isNoStreamsFoundError}}
					{{t "modal.streaming.body.error.no-streams-found" provider=providerName}}
				{{else if isTimeoutError}}
					{{t "modal.streaming.body.error.timeout" name=modalContext.user.detailedName}}
				{{else if hasDiagnostics}}
					{{t "modal.streaming.body.error.diagnostics"}}
				{{else}}
					{{t "modal.streaming.body.error.internal"}}
				{{/if}}
			</p>
		{{else if preparing}}
			<div class="streaming-progress" role="status">
				{{loading-spinner}}
				<span>{{modalContext.user.detailedName}}</span>
			</div>
		{{else if modalContext.hasEnded}}
			<p class="streaming-message" role="status">{{t "modal.streaming.body.ended"}}</p>
		{{else if modalContext.isLaunching}}
			<div class="streaming-progress" role="status">
				{{loading-spinner}}
				<span>{{t "modal.streaming.body.launching" provider=providerName}}</span>
			</div>
		{{else if modalContext.isWatching}}
			{{#if modalContext.stream.game_name}}
				<div class="streaming-game">
					{{#if modalContext.stream.game_id}}
						{{#link-to "games.game" modalContext.stream.game_id tabindex=0}}
							{{modalContext.stream.game_name}}
						{{/link-to}}
					{{else}}
						{{modalContext.stream.game_name}}
					{{/if}}
				</div>
			{{/if}}
			{{stats-row stream=modalContext.stream withFlag=false}}
			{{embedded-links tagName="section" class="streaming-description" text=modalContext.stream.title tabindex=0}}
			<div class="streaming-quality">
				<div class="streaming-quality-controls state-actions">
					<label for="{{elementId}}-quality">{{t "modal.streaming.quality.label"}}</label>
					<select
						id="{{elementId}}-quality"
						aria-describedby="{{elementId}}-quality-help"
						onchange={{action (mut pendingQuality) value="target.value"}}
					>
						{{#each qualities as |quality|}}
							<option value={{quality.id}} selected={{is-equal quality.id pendingQuality}}>
								{{t (concat "qualities." quality.id)}}
							</option>
						{{/each}}
					</select>
					<button type="button" class="state-action" disabled={{unless qualityChanged true}} {{action "applyQuality"}}>
						{{t "components.settings-submit.apply"}}
					</button>
				</div>
				<p id="{{elementId}}-quality-help">{{t "modal.streaming.quality.restart"}}</p>
			</div>
		{{/if}}
		{{#unless preparing}}
			{{#if hasDiagnostics}}
				<div class="streaming-diagnostics {{if modalContext.warning "has-warning"}}">
					<button
						type="button"
						class="streaming-log-toggle"
						aria-expanded={{if modalContext.showLog "true" "false"}}
						aria-controls="{{elementId}}-diagnostics"
						title={{hotkey-title context=this action="log" title=(t "modal.streaming.action.log" provider=providerName)}}
						{{action "toggleLog"}}
					>
						<i class="fa {{if modalContext.showLog "fa-chevron-up" "fa-chevron-down"}}" aria-hidden="true"></i>
						{{t "modal.streaming.action.log" provider=providerName}}
						{{#if modalContext.warning}}
							<i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
							<span class="sr-only">{{t "modal.streaming.body.warning"}}</span>
						{{/if}}
					</button>
					<div class="streaming-diagnostics-content" id="{{elementId}}-diagnostics" hidden={{unless modalContext.showLog true}}>
						{{#if modalContext.showLog}}
							{{#if errorDetails}}
								<p data-selectable>
									{{errorDetails}}
									{{#if error.error.message}}<br>{{error.error.message}}{{/if}}
								</p>
							{{/if}}
							{{#if diagnosticLog.length}}
								{{modal-log log=diagnosticLog}}
							{{/if}}
						{{/if}}
					</div>
				</div>
			{{/if}}
		{{/unless}}
	{{/modal-body}}
	{{#modal-footer}}
		<div class="streaming-actions state-actions">
			{{#if preparing}}
				<button type="button" class="state-action" {{action "abort"}}>
					{{t "modal.streaming.action.abort"}}
				</button>
			{{else if modalContext.hasEnded}}
				<button type="button" class="state-action" {{action "shutdown"}}>
					{{t "modal.dialog.action.close"}}
				</button>
				{{#if errorSettingsRoute}}
					{{#if (bool-or isProviderError isVersionError)}}
						<button type="button" class="state-action" {{action "download"}}>
							{{t "modal.streaming.action.download"}}
						</button>
					{{/if}}
					{{#unless isVersionError}}
						<button type="button" class="state-action" {{action "restart"}}>
							{{t "modal.streaming.action.restart"}}
						</button>
					{{/unless}}
					<button
						type="button"
						class="state-action state-action-primary"
						title={{hotkey-title context=this action="confirm" title=(t (if isPlayerError "modal.streaming.action.player-settings" "modal.streaming.action.provider-settings"))}}
						{{action "openSettings"}}
					>
						{{t (if isPlayerError "modal.streaming.action.player-settings" "modal.streaming.action.provider-settings")}}
					</button>
				{{else}}
					<button
						type="button"
						class="state-action state-action-primary"
						title={{hotkey-title context=this action="confirm" title=(t "modal.streaming.action.restart")}}
						{{action "restart"}}
					>
						{{t "modal.streaming.action.restart"}}
					</button>
				{{/if}}
			{{else}}
				<button
					type="button"
					class="state-action streaming-stop"
					title={{hotkey-title context=this action="shutdown" title=(t "modal.streaming.action.shutdown")}}
					{{action "shutdown"}}
				>
					{{t "modal.streaming.action.shutdown"}}
				</button>
				<button
					type="button"
					class="state-action state-action-primary"
					title={{hotkey-title context=this action="close" title=(t "modal.streaming.action.continue")}}
					{{action "close"}}
				>
					{{t "modal.streaming.action.continue"}}
				</button>
			{{/if}}
		</div>
		{{#unless (bool-or preparing modalContext.hasEnded)}}
			<div class="streaming-tools">
				{{open-chat user=modalContext.user}}
				{{twitch-emotes user=modalContext.user}}
				{{share-channel user=modalContext.user}}
				{{channel-button user=modalContext.user}}
			</div>
		{{/unless}}
	{{/modal-footer}}
</div>
