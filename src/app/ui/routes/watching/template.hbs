<main class="content content-watching">
	<h2>{{t "routes.watching.header"}}</h2>
	{{#if model.length}}
		<ul class="watching-list list-unstyled">
			{{#each sortedModel as |session|}}
				{{stream-presentation
					session=session
					showDetails=(action "openDialog" session)
					closeSession=(action "closeStream" session.stream)
				}}
			{{/each}}
		</ul>
	{{else}}
		<section class="state-panel" aria-labelledby="watching-empty-title">
			<h3 class="state-panel-title" id="watching-empty-title">{{t "routes.watching.empty.header"}}</h3>
			<p>{{t "routes.watching.empty.next"}}</p>
			<div class="state-actions">
				{{#link-to "streams" class="state-action state-action-primary" tabindex=0}}
					{{t "routes.watching.empty.streams"}}
				{{/link-to}}
				{{#if auth.session.isLoggedIn}}
					{{#link-to "user.followedStreams" class="state-action" tabindex=0}}
						{{t "routes.watching.empty.followed"}}
					{{/link-to}}
				{{/if}}
			</div>
		</section>
	{{/if}}
</main>
